# ============================================
# SENTRIX — MODEL INFERENCE CONFIGURATION
# ============================================

# PASTE YOUR BASETEN API KEY BELOW
BASETEN_API_KEY=your_baseten_api_key_here

# Model Endpoint Configuration
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026

# Application Environment
APP_ENV=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL / SQLite fallback supported for standalone dev)
DATABASE_URL=sqlite+aiosqlite:///./data/sentrix.db
# For production PostgreSQL: postgresql+psycopg://sentrix:sentrix@localhost:5432/sentrix

# Cache Configuration (Redis / In-memory fallback supported)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting & Safety
DEMO_MODE=true
MAX_INFERENCE_CALLS_PER_MINUTE=20
